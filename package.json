{
  "name": "cfe2e-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "client": "node src/client/server.js",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/deploy.js",
    "test": "node --test"
  },
  "cloudflare": {
    "bindings": {
      "APP_PASSWORD": {
        "description": "只填写门禁密码。请使用至少 32 个随机字符。加密主密码只在本地客户端输入。"
      }
    }
  },
  "devDependencies": {
    "wrangler": "^4.55.0"
  }
}

